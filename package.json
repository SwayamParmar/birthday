{
  "name": "birthday-bloom",
  "private": true,
  "version": "3.5.0",
  "type": "module",
  "license": "MIT",
  "author": "Naboraj Sarkar",
  "homepage": "https://github.com/naborajs/birthday-bloom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naborajs/birthday-bloom.git"
  },
  "bugs": {
    "url": "https://github.com/naborajs/birthday-bloom/issues"
  },
  "description": "A single-recipient birthday gift: PIN lock, cupid's bow, blooming heart tree, cake, balloon reasons, memory lane, a letter, and a fireworks finale. All content lives in src/config/gift.ts.",
  "keywords": [
    "birthday",
    "react",
    "framer-motion",
    "tailwind-css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.16.5",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^20.0.3",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "brace-expansion": "^2.1.4",
    "nanoid": "^3.3.18"
  }
}
